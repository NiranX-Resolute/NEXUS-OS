  "name": "Flutter/Dart\u30b3\u30fc\u30c9\u30ec\u30d3\u30e5\u30fc\u30d9\u30b9\u30c8\u30d7\u30e9\u30af\u30c6\u30a3\u30b9",
  "type": "skill",
