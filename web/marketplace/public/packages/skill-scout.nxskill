  "schema_version": "1.0",
  "slug": "skill-scout",
  "name": "\u30b9\u30ad\u30eb\u30b9\u30ab\u30a6\u30c8",
  "type": "skill",
  "orbiter_group": "DEV-01",
  "category": "community",
  "permission_scope": [
