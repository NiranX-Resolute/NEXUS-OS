  "schema_version": "1.0",
  "slug": "safety-guard",
  "name": "Safety Guard \u2014 \u7834\u58ca\u7684\u306a\u64cd\u4f5c\u306e\u9632\u6b62",
  "type": "skill",
  "orbiter_group": "DEV-01",
