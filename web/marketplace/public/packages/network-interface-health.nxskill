  "slug": "network-interface-health",
  "name": "\u30cd\u30c3\u30c8\u30ef\u30fc\u30af\u30a4\u30f3\u30bf\u30fc\u30d5\u30a7\u30fc\u30b9\u30d8\u30eb\u30b9",
  "type": "skill",
