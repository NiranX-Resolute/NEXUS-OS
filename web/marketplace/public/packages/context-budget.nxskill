  "schema_version": "1.0",
  "slug": "context-budget",
  "name": "\u30b3\u30f3\u30c6\u30ad\u30b9\u30c8\u30d0\u30b8\u30a7\u30c3\u30c8",
  "type": "skill",
  "orbiter_group": "DEV-01",
