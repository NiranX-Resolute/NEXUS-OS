  "schema_version": "1.0",
  "slug": "ai-first-engineering",
  "name": "AI \u30d5\u30a1\u30fc\u30b9\u30c8\u30a8\u30f3\u30b8\u30cb\u30a2\u30ea\u30f3\u30b0",
  "type": "skill",
