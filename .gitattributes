# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Explicit binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.icns binary
*.bmp binary
*.wasm binary
*.exe binary
*.dll binary
*.so binary
*.dylib binary
*.img binary
*.iso binary
*.dmg binary
*.AppImage binary
*.zip binary
*.tar binary
*.tar.gz binary
*.db binary
*.sqlite binary
*.sqlite3 binary

# Shell scripts and batch files
*.sh text eol=lf
*.bash text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Source code files
*.py text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.toml text eol=lf
*.md text eol=lf
*.html text eol=lf
*.css text eol=lf
